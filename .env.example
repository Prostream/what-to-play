# Copy to .env and add your Atlas connection strings there.
# Never commit real usernames or passwords.
# Games API, accounts, and import scripts use these variables.
MONGODB_URI=
MONGODB_DB=what_to_play_dev

# Music catalog and saved songs use a separate database.
MUSIC_MONGODB_URI=
MUSIC_MONGODB_DB=what_to_play_music
PORT=3000
